# ── Azure AD 서비스 주체 (PowerBI-Gateway 앱 등록) ─────────────────────────────
# 용도: 우리 서버가 Power BI REST API를 부를 때 쓰는 인증 (client credentials 방식,
#       사람 계정 로그인이 아니다). Pro/PPU 같은 사람 라이선스는 여기 안 들어간다 —
#       이 인증 방식 자체가 라이선스 없이 동작하도록 만들어진 것이다.
# 필요한 기능: Embed Token 발급(보고서 열람), .pbix 업로드/게시, RLS 렌더링, PBI 동기화.
# 없거나 틀려도 서버 자체는 뜨지만 위 Power BI 관련 기능만 전부 실패한다.
TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# ── Power BI 워크스페이스 ──────────────────────────────────────────────────────
# 이 앱이 보고서를 읽고 쓰는 대상 워크스페이스 ID. 워크스페이스에 어떤 캐패시티가
# 붙어있는지는 Power BI 클라우드 쪽 설정이라 여기 값과는 무관하다.
# 상세: docs/05_라이선스_용량_비용가이드.md
WORKSPACE_ID=your-workspace-id

# 동적 RLS 역할 이름 — Power BI Desktop에서 만든 보안 역할 이름과 반드시 일치해야 한다
# (docs/01_RLS_적용가이드.md). 바꾸려면 여기뿐 아니라 관련 PBIX 전부의 역할 이름도 같이
# 바꿔야 한다 — 여기만 바꾸면 기존 RLS 걸린 보고서가 전부 깨진다.
PBI_RLS_ROLE_NAME=도메인

# ── 앱 자체 보안 (Azure AD/Power BI와 완전히 무관 — 우리 로그인 시스템 전용) ─────
# SECRET_KEY: 로그인 세션 쿠키 + 탭별 로그인 토큰을 서명하는 값. 32자 미만이면
#             서버 시작 자체가 거부된다 — 임의의 긴 랜덤 문자열로 반드시 교체할 것
#             (예: python -c "import secrets; print(secrets.token_hex(32))").
#             운영 중엔 절대 바꾸지 말 것 — 바꾸면 전원 강제 로그아웃.
# COOKIE_SECURE: true면 HTTPS 연결에서만 쿠키 전송. 로컬 개발은 false, 실제 서비스는 true.
SECRET_KEY=change-me-to-at-least-32-random-characters
COOKIE_SECURE=false

# ── 사용자 업로드 제한 ─────────────────────────────────────────────────────────
MAX_UPLOADS_PER_DAY=10       # 사용자 1명이 하루에 올릴 수 있는 최대 보고서 수
MAX_PERSONAL_REPORTS=20      # 사용자 1명이 소유할 수 있는 개인 보고서 최대 개수

# ── PBI 삭제 동기화 주기 (초, 0이면 끔 — 시작 시 1회와 관리자 수동 동기화는 항상 동작) ──
PBI_SYNC_INTERVAL=600

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=powerbi_gateway
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# 커넥션 풀 크기 (프로세스당)
DB_POOL_MIN=2
DB_POOL_MAX=20

# pg_dump 실행 파일. 생략하면 PATH, 기존 Windows 설치 경로 순으로 탐색한다.
# DB 서버와 같거나 더 높은 메이저 버전이 필요하다.
# PG_DUMP_PATH=C:\PostgreSQL\16\bin\pg_dump.exe

# ── 네비게이션 허브 (선택) ──────────────────────────────────────────────────────
# 설정하면 상단바에 "마케팅 포털" 링크가 새 탭으로 나타남. 없으면 링크 자체가 안 보임.
# MARKETING_PORTAL_URL=http://localhost:5173

# ── MS 계정 로그인 / SSO (선택) ─────────────────────────────────────────────────
# 설정하면 로그인 화면에 "Microsoft 계정으로 로그인" 버튼이 나타남. 없으면 버튼 자체가
# 안 보이고 기존 비밀번호 로그인만 동작(2026-08-20 도입).
# 위 CLIENT_ID/TENANT_ID 앱 등록의 "인증(Authentication)" 메뉴에 "웹" 플랫폼으로
# 이 값과 정확히 같은 리디렉션 URI를 등록해야 한다 — localhost가 아니면 반드시 https://.
# SSO_REDIRECT_URI=http://localhost:8249/auth/callback
