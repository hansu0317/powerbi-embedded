# 환경 설정 (비밀 키, DB 비밀번호 등 — 절대 커밋 금지)
.env
.env.*
!.env.example

# Claude Code 내부 설정 파일
CLAUDE.md
.claude/

# 검토하여 정리한 공통 문서만 공유. 미검토 내부 자료는 계속 제외.
docs/*
!docs/00_학습_로드맵.md
!docs/01_RLS_적용가이드.md
!docs/02_백엔드_DB_API_흐름.md
!docs/04_서버_운영_가이드.md
!docs/05_라이선스_용량_비용가이드.md
!docs/06_인프라_현황.md
!docs/07_일반사용자_보고서열람가이드.md
!docs/08_프로젝트_점검결과.md
.audit/

# 발표 자료 / 바이너리
*.pptx
*.ppt
*.pdf

# Codex 발표자료 생성·렌더링 임시 산출물
.codex-ppt*/
.codex-finalizer/

# 외부 문서 (경쟁사 매뉴얼 등 — 절대 커밋 금지)
pdfpptx/
*.docx

# 다른 회사 RLS 참고 자료 (실제 사내망 IP·테이블명 포함 — 절대 커밋 금지)
example/

# 문서 포맷 예시 이미지 (다른 프로젝트 스크린샷 — 절대 커밋 금지)
defineview/

# Python 캐시
__pycache__/
*.pyc
*.pyo
*.pyd
token_cache.json

# 서버 런타임 파일
.server.pid

# DB 백업 (비밀번호 해시 등 민감정보 포함 — 절대 커밋 금지)
backups/
logs/
*.log

# 가상환경
venv/
.venv/
env/

# 기타 임시 파일
0
*.tmp
*.bak

# 디자인 목업 이미지 (커밋 제외)
images/

# scripts/check_rls_render.py 출력 — embed token/스크린샷, 매 실행마다 재생성됨
scripts/.rls_render_out/

# 프론트엔드 (Vite + React + TS) — 소스는 커밋, 빌드 의존성·산출물은 제외
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts
